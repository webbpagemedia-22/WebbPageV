# Cloudflare reads this file and adds these headers to every response.
# It is not served as a page itself.

# Basic browser safety headers for every page and file.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Keep the Cloudflare test address (*.workers.dev) out of Google, so it can't
# compete with webbpageventura.co.uk as duplicate content.
https://:worker.:subdomain.workers.dev/*
  X-Robots-Tag: noindex
