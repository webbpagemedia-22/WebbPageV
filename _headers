# Cloudflare reads this file and adds these headers to every response.
# It is not served as a page itself.

# Basic browser safety headers for every page and file.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Keep the Cloudflare test address (*.workers.dev) out of Google, so it can't
# compete with webbpageventura.co.uk as duplicate content.
https://:worker.:subdomain.workers.dev/*
  X-Robots-Tag: noindex

# Let browsers keep pictures for a week instead of re-checking them on every
# page view (Cloudflare's default is max-age=0). Faster repeat visits. If a
# picture is ever replaced under the same file name, give it a new name or
# allow up to a week for returning visitors to see the new one.
/images/*
  Cache-Control: public, max-age=604800

# Same for the recipe book's photos, which live outside /images/ (about 4.5 MB
# across 16 photos). Same rule: rename a photo if it's ever replaced.
/neuro-spicy-cookbook/images/*
  Cache-Control: public, max-age=604800

# Same for the Ginganinja book page's illustrations (about 3.5 MB across 16
# pictures). Same rule: rename a picture if it's ever replaced.
/ginganinja/images/*
  Cache-Control: public, max-age=604800
